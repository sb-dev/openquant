{
  "name": "@openquant/agent-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Isolated host process that runs the pinned delegated executor for one agent attempt",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run --reporter=default --reporter=./test-reporter.ts",
    "build": "tsc -p tsconfig.json && node tools/bundle.ts",
    "start": "node dist/agent-runner.mjs"
  },
  "dependencies": {
    "@openquant/agents": "workspace:*",
    "@openquant/api-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
