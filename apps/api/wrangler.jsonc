// The control API Worker (OQ-05 section 1: Hono on Cloudflare Workers, Neon through Hyperdrive, R2 for artefacts).
//
// This file names the bindings and settings that the code reads. It holds no identifier, no bucket name and no secret
// value: the delivery job of P6 adds the Hyperdrive id and the R2 bucket name per environment, and sets the secret
// with `wrangler secret put`. wrangler is not installed in this repository (apps/api/README.md, "Why the tests run in
// Node"), so this file has not been read by wrangler, and `wrangler deploy` fails until P6 supplies the missing ids.
//
// Secrets, never listed here (names only, see .dev.vars.example):
//   TOKEN_SIGNING_KEY  base64url of at least 32 random bytes: the HMAC key of access tokens and attempt capabilities
//   AGENT_RUNNER_URL, AGENT_RUNNER_CREDENTIAL  the https base URL of the agent runner and the credential of the workflows
//                      service principal; the scheduled dispatcher sends agent-dispatch/1 with them
{
  "name": "openquant-api",
  "main": "src/worker.ts",
  // nodejs_compat is needed by node-postgres (pg) through Hyperdrive. Move the date forward with a review of the
  // compatibility changes, and run the tests after it (workers-best-practices).
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    // DEVELOPMENT, STAGING or PRODUCTION. The delivery job sets it for each environment.
    "OPENQUANT_ENVIRONMENT": "DEVELOPMENT",
    // `enabled` turns research execution on. It stays `disabled` until the deployment is verified (OQ-05 section 4):
    // run_mission_now answers EXECUTION_DISABLED, and nothing is dispatched to the batch host or the agent runner.
    "OPENQUANT_RESEARCH_EXECUTION": "disabled",
    // The pinned Claude Code CLI version that the agent runner runs (AGENT_RUNNER_EXECUTOR_VERSION of the runner). Every
    // agent-dispatch/1 names it, and the runner refuses another. 2.1.325 is the candidate of the pilot record.
    "AGENT_EXECUTOR_VERSION": "2.1.325"
  },
  "hyperdrive": [
    // Query caching is disabled on the Hyperdrive resource itself (OQ-05 section 1); Terraform creates it with
    // caching off in P6, and the application never reads a cached answer for private state.
    { "binding": "HYPERDRIVE" }
  ],
  "r2_buckets": [
    // Immutable artefacts, keyed by SHA-256. The Fly hosts hold no R2 credentials: they upload through this Worker.
    { "binding": "ARTEFACTS" }
  ],
  "queues": {
    // The one batch queue (OQ-05 section 1). The scheduled dispatcher produces job-dispatch/1 messages to it; the batch
    // host pulls them through the Queues HTTP API (an HTTP-pull consumer, no push consumer). P6 adds the queue name.
    "producers": [{ "binding": "BATCH_QUEUE" }]
  },
  "triggers": {
    // Recovery and the outbox dispatcher: expired leases and unsent dispatches are found with no client connected.
    "crons": ["* * * * *"]
  }
}
