{
  "name": "@openquant/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Control application: Hono routes, authentication, guarded commands and SQL migrations (OQ-05 sections 2 to 5, 7, 9)",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run --reporter=default --reporter=./test-reporter.ts",
    "build": "tsc -p tsconfig.json && node tools/bundle-check.ts",
    "migrate": "node tools/migrate.ts",
    "bootstrap": "node tools/bootstrap.ts"
  },
  "dependencies": {
    "@openquant/agents": "workspace:*",
    "@openquant/api-contracts": "workspace:*",
    "hono": "4.13.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@openquant/api-client": "workspace:*",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
