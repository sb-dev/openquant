{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalDependencies": ["tsconfig.base.json", "biome.json"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
