{
  "name": "@openquant/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Typed client of the S1 API routes: response validation, command IDs and read-back, resynchronisation and typed errors",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run --reporter=default --reporter=./test-reporter.ts",
    "build": "tsc -p tsconfig.json && node tools/bundle-check.ts"
  },
  "dependencies": {
    "@openquant/api-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
