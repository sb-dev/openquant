{
  "schema": "api-route-manifest/1",
  "note": "HTTP routes of the S1 API (host api) and the agent runner dispatch endpoint (host agent-runner). auth lists the credentials a route accepts; any one of them is enough. A contract body names a schema in packages/api-contracts/schemas by its short name; form selects one form of a two-form contract. A view body is an API-owned JSON document, such as a read model: it is not a cross-runtime contract and apps/api owns its shape. bytes is a raw artefact body addressed by its SHA-256 digest. max_body_bytes bounds a request body: the API refuses a larger one with LIMIT_EXCEEDED before it parses it. Every route with a request body declares it. For a contract body it is the contract's Worker byte limit (workerBodyLimit in packages/api-contracts/ts), at which the parse of every body that the memory test measures stays within half of a Worker isolate's memory in Node 24 (OQ-05 section 7). The limit bounds memory, not CPU time: the time of the schema checks follows from the patterns, which the generated validators run in linear time (OQ-05 section 7). A bytes body may reach the 16 MiB strict-JSON limit; the API hashes and stores it without parsing it. When an evaluation-submission cites an evaluation-result/1, the API scans that result before it commits it (scanEvaluationResult, within RESULT_SCAN_LIMIT of 8 MiB): strict JSON and the array, object, string and key limits of OQ-05 section 7 over the whole document, but not the value limit, the schema over its head, and the bindings of the head to the request and the submission. A larger result fails the submission with LIMIT_EXCEEDED (OQ-05 sections 4 and 7). Every error body is the api-error contract. A route lists INVALID_DECIMAL only when its request contract has a decimal field that no oneOf lies above: a malformed decimal is INVALID_DECIMAL only when it is the document's only kind of violation (OQ-05 section 7), so a decimal inside command/1, whose root is a oneOf, is SCHEMA_VIOLATION. common_errors apply to every route in addition to its own errors. The internal commands record_evaluation_decision and freeze_candidates have no route. runs.metrics and runs.result return the committed official evaluation-metrics/1 and evaluation-result/1 of one run unchanged, served from storage by content hash, with NOT_FOUND while none is committed: a FAILED or INSUFFICIENT run has no metrics, and a run that ended before the core prepared it has no result. Clients show these official values and never recompute them (OQ-04 section 5, OQ-05 section 7).",
  "version": "v1",
  "base_path": "/v1",
  "error_body": "api-error",
  "common_errors": ["UNAUTHENTICATED", "FORBIDDEN", "RATE_LIMITED", "UNAVAILABLE", "INTERNAL"],
  "error_status": {
    "UNSUPPORTED_SCHEMA_VERSION": 400,
    "SCHEMA_VIOLATION": 400,
    "INVALID_DECIMAL": 400,
    "UNAUTHENTICATED": 401,
    "FORBIDDEN": 403,
    "NOT_FOUND": 404,
    "REVISION_CONFLICT": 409,
    "COMMAND_ID_REUSED": 409,
    "STALE_OWNERSHIP": 409,
    "LEASE_EXPIRED": 409,
    "ATTEMPT_NOT_CLAIMABLE": 409,
    "IDENTITY_MISMATCH": 422,
    "DIGEST_MISMATCH": 422,
    "POLICY_VIOLATION": 422,
    "BUDGET_EXHAUSTED": 409,
    "EXECUTION_DISABLED": 409,
    "LIMIT_EXCEEDED": 413,
    "RATE_LIMITED": 429,
    "UNAVAILABLE": 503,
    "INTERNAL": 500
  },
  "auth_kinds": {
    "human_credential": "A person's long-lived credential. Accepted only by the token route.",
    "human": "A 15-minute access token of a person. roles lists the roles that may call the route.",
    "service": "An environment- and operation-scoped service principal credential. principals lists the principals that may call the route. A service principal has no trading authority. It cannot approve policies, create or enlarge budgets or change limits; it may reserve within existing budgets. workflows records policy-determined Decisions only under an approved cohort policy. The deploy credential is scoped to the single route releases.record and is held only in the protected delivery job.",
    "attempt": "The attempt-scoped capability from an attempt-claim grant. It is valid only for the attempt in the path and expires with the lease."
  },
  "views": {
    "access-token": "Access token, its expiry, the principal and its roles.",
    "system-identity": "The current release identity, as recorded from release-manifest/1: source SHA, CLI version, engine digest, image and binary digests, bundle hash, method identity, protocol versions, migration level and deployment references. releases.record returns it after it records a manifest, so the delivery job reads back what was stored.",
    "mission": "Mission status and outcome with its reasons, scope, profile, cohort policy, evaluation plan digest, per-mission budget with reservations and usage, candidates by trial slot, typed jobs (retrieve, validate, evaluate and assess) with their attempts, and attention items.",
    "lineage": "Generated Strategy Graph of the mission: versions, parents, rule changes and linked runs, findings and decisions.",
    "trials": "Planned run slots and registered trials, including failed and discarded ones, with run IDs, run status, mode, environment and holdout consumption. A run's official metrics and result are read from runs.metrics and runs.result; the view repeats none of their values.",
    "findings": "Critic findings with category, finding_source, applicability and policy treatment per lifecycle transition.",
    "gates": "Gate reports per candidate with eligibility.",
    "decisions": "Recorded Decisions with actor, outcome and evidence references. A policy-determined Decision also names the cohort policy digest, the Steward approval Decision and the Researcher who started the mission.",
    "job": "Job kind, attempts with outcome, lease and ownership revision, and dispatch state."
  },
