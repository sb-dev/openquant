{
  "schema": "api-route-manifest/1",
  "note": "HTTP routes of the S1 API (host api) and the agent runner dispatch endpoint (host agent-runner). auth lists the credentials a route accepts; any one of them is enough. A contract body names a schema in packages/api-contracts/schemas by its short name; form selects one form of a two-form contract. A view body is an API-owned JSON document, such as a read model: it is not a cross-runtime contract and apps/api owns its shape. bytes is a raw artefact body addressed by its SHA-256 digest. Every error body is the api-error contract. common_errors apply to every route in addition to its own errors.",
  "version": "v1",
  "base_path": "/v1",
  "error_body": "api-error",
  "common_errors": ["UNAUTHENTICATED", "FORBIDDEN", "RATE_LIMITED", "UNAVAILABLE", "INTERNAL"],
  "error_status": {
    "UNSUPPORTED_SCHEMA_VERSION": 400,
    "SCHEMA_VIOLATION": 400,
    "INVALID_DECIMAL": 400,
    "UNAUTHENTICATED": 401,
    "FORBIDDEN": 403,
    "NOT_FOUND": 404,
    "REVISION_CONFLICT": 409,
    "COMMAND_ID_REUSED": 409,
    "STALE_OWNERSHIP": 409,
    "LEASE_EXPIRED": 409,
    "ATTEMPT_NOT_CLAIMABLE": 409,
    "IDENTITY_MISMATCH": 422,
    "DIGEST_MISMATCH": 422,
    "POLICY_VIOLATION": 422,
    "BUDGET_EXHAUSTED": 409,
    "EXECUTION_DISABLED": 409,
    "LIMIT_EXCEEDED": 413,
    "RATE_LIMITED": 429,
    "UNAVAILABLE": 503,
    "INTERNAL": 500
  },
  "auth_kinds": {
    "operator_credential": "The human operator's long-lived credential. Accepted only by the token route.",
    "operator": "A 15-minute operator access token. roles lists the roles that may call the route.",
    "service": "An environment- and operation-scoped service principal credential. principals lists the principals that may call the route. No service principal has trading authority.",
    "attempt": "The attempt-scoped capability from an attempt-claim grant. It is valid only for the attempt in the path and expires with the lease."
  },
  "views": {
    "access-token": "Access token, its expiry, the principal and its roles.",
    "system-identity": "Release identity: source SHA, image and binary digests, bundle hash, method identity, protocol versions and migration level.",
    "mission": "Mission status and outcome, scope, profile, cohort policy, budgets with reservations and usage, candidates, attempts and attention items.",
    "lineage": "Generated Strategy Graph of the mission: versions, parents, rule changes and linked runs, findings and decisions.",
    "trials": "Registered trials and comparisons, including failed and discarded ones, with run status, mode, environment and holdout consumption.",
    "findings": "Critic findings with category, finding_source, applicability and policy treatment per lifecycle transition.",
    "gates": "Gate reports per candidate with eligibility.",
    "decisions": "Recorded Decisions with actor, evidence references, policy revision and outcome.",
    "job": "Job kind, attempts with outcome, lease and ownership revision, and dispatch state.",
    "release-identity": "Release identity manifest written by deploy.yml: source SHA, CLI version, engine digest, image and binary digests, bundle hash, method identity, protocol versions, migration level and deployment references."
  },
  "routes": [
    {
      "id": "auth.token",
      "host": "api",
      "method": "POST",
      "path": "/v1/auth/token",
      "auth": [{ "kind": "operator_credential" }],
      "request": { "kind": "none" },
      "response": { "kind": "view", "view": "access-token" },
      "success_status": 200,
      "errors": []
    },
    {
      "id": "system.identity",
      "host": "api",
      "method": "GET",
      "path": "/v1/system/identity",
      "auth": [{ "kind": "operator", "roles": ["Viewer", "Researcher", "Steward", "Administrator"] }, { "kind": "service", "principals": ["workflows", "deploy"] }],
      "request": { "kind": "none" },
      "response": { "kind": "view", "view": "system-identity" },
      "success_status": 200,
      "errors": []
    },
    {
      "id": "releases.record",
      "host": "api",
      "method": "POST",
      "path": "/v1/releases",
      "auth": [{ "kind": "operator", "roles": ["Administrator"] }, { "kind": "service", "principals": ["deploy"] }],
      "request": { "kind": "view", "view": "release-identity" },
      "response": { "kind": "none" },
      "success_status": 204,
      "errors": ["SCHEMA_VIOLATION", "IDENTITY_MISMATCH", "REVISION_CONFLICT"]
    },
    {
      "id": "research-profiles.register",
      "host": "api",
      "method": "POST",
      "path": "/v1/research-profiles",
      "auth": [{ "kind": "operator", "roles": ["Steward"] }],
      "request": { "kind": "contract", "contract": "command", "form": "request", "command_kind": "register_research_profile" },
      "response": { "kind": "contract", "contract": "command", "form": "status" },
      "success_status": 202,
      "errors": ["UNSUPPORTED_SCHEMA_VERSION", "SCHEMA_VIOLATION", "INVALID_DECIMAL", "REVISION_CONFLICT", "COMMAND_ID_REUSED", "POLICY_VIOLATION"]
    },
    {
      "id": "cohort-policies.register",
      "host": "api",
      "method": "POST",
      "path": "/v1/cohort-policies",
      "auth": [{ "kind": "operator", "roles": ["Steward"] }],
      "request": { "kind": "contract", "contract": "command", "form": "request", "command_kind": "register_cohort_policy" },
      "response": { "kind": "contract", "contract": "command", "form": "status" },
