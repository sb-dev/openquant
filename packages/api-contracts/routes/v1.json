      "errors": ["UNSUPPORTED_SCHEMA_VERSION", "SCHEMA_VIOLATION", "INVALID_DECIMAL", "NOT_FOUND", "REVISION_CONFLICT", "COMMAND_ID_REUSED", "POLICY_VIOLATION"]
