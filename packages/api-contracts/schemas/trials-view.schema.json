{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openquant:schema:trials-view:1",
  "title": "TrialsView",
  "description": "Trial slots, planned run slots with their run (null while the slot is only planned) and every proposal, invalid and discarded ones too. It repeats no official value of a run. The response body of missions.trials (routes/v1.json). A value that nothing reported is null, never zero; arrays are always present and may be empty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "plan_digest", "trial_slots", "run_slots", "trials"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["trials-view/1"] },
    "mission_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
    "plan_digest": {
      "oneOf": [
        { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewDigest" },
        { "type": "null" }
      ]
    },
    "trial_slots": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/ViewTrialSlot" }
    },
    "run_slots": {
      "type": "array",
      "items": { "$ref": "#/$defs/ViewRunSlot" },
      "maxItems": 256
    },
    "trials": {
      "type": "array",
      "items": { "$ref": "#/$defs/ViewTrial" },
      "maxItems": 128
    }
  },
  "$defs": {
    "ViewPlannedRun": {
      "title": "ViewPlannedRun",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "mode", "environment", "attempts", "failure_code", "waiting_reason", "completed_at", "holdout_consumed"],
      "properties": {
        "run_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "status": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/RunStatus" },
        "mode": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/EvaluationMode" },
        "environment": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/DeploymentEnvironment" },
        "attempts": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewCount" },
        "failure_code": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewText" },
            { "type": "null" }
          ]
        },
        "waiting_reason": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewText" },
            { "type": "null" }
          ]
        },
        "completed_at": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewTimestamp" },
            { "type": "null" }
          ]
        },
        "holdout_consumed": { "type": "boolean" }
      }
    },
    "ViewRunSlot": {
      "title": "ViewRunSlot",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_slot", "trial_slot", "window_role", "cost_scenario", "written_by", "replay_of", "run"],
      "properties": {
        "run_slot": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "trial_slot": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "window_role": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/WindowRole" },
        "cost_scenario": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/CostScenario" },
        "written_by": { "type": "string", "enum": ["EVALUATING_DECISION", "FREEZE_CANDIDATES"] },
        "replay_of": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewIdentifier" },
            { "type": "null" }
          ]
        },
        "run": {
          "oneOf": [
            { "$ref": "#/$defs/ViewPlannedRun" },
            { "type": "null" }
          ]
        }
      }
    },
    "ViewTrial": {
      "title": "ViewTrial",
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "trial_slot", "proposal_ordinal", "draft_digest", "status", "strategy_hash", "reason", "created_at"],
      "properties": {
        "trial_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "trial_slot": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "proposal_ordinal": { "type": "integer", "minimum": 1, "maximum": 100 },
        "draft_digest": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "status": { "type": "string", "enum": ["DRAFTED", "INVALID", "REGISTERED", "DISCARDED"] },
        "strategy_hash": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewDigest" },
            { "type": "null" }
          ]
        },
        "reason": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewText" },
            { "type": "null" }
          ]
        },
        "created_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" }
      }
    },
    "ViewTrialSlot": {
      "title": "ViewTrialSlot",
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_slot", "kind", "configuration_id", "parent_slot", "terminal_reason", "terminal_at"],
      "properties": {
        "trial_slot": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "kind": { "type": "string", "enum": ["SEED", "REVISION"] },
        "configuration_id": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewIdentifier" },
            { "type": "null" }
          ]
        },
        "parent_slot": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewIdentifier" },
            { "type": "null" }
          ]
        },
        "terminal_reason": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewState" },
            { "type": "null" }
          ]
        },
        "terminal_at": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewTimestamp" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
