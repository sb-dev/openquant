{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openquant:schema:gate-report:1",
  "title": "GateReport",
  "description": "Gate results of one candidate under one cohort policy, written by the Rust assess job (OQ-02 sections 3.2 and 3.6). The API only applies finding treatment and combines results. A gate pass grants no capital, and a completed run can fail its gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "attempt", "executable", "method", "strategy_hash", "cohort_policy", "inputs", "gates"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["gate-report/1"] },
    "job_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
    "attempt": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/AttemptBinding" },
    "executable": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ExecutableIdentity" },
    "method": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/MethodIdentity" },
    "strategy_hash": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
    "cohort_policy": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/RecordRef" },
    "inputs": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/GateInput" } },
    "gates": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/GateOutcome" } }
  },
  "$defs": {
    "GateInput": {
      "title": "GateInput",
      "description": "One artefact the assessment read. run_id is present for run artefacts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["VALIDATION_RESULT", "EVALUATION_SUBMISSION", "EVALUATION_RESULT", "EVALUATION_METRICS", "DATASET_MANIFEST"]
        },
        "run_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "digest": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" }
      }
    },
    "GateOutcome": {
      "title": "GateOutcome",
      "oneOf": [{ "$ref": "#/$defs/DecidedGate" }, { "$ref": "#/$defs/UndecidedGate" }]
    },
    "DecidedGate": {
      "title": "DecidedGate",
      "description": "PASS or FAIL, with the input digests behind it and the observed value of each threshold.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "gate", "category", "evidence", "observations"],
      "properties": {
        "result": { "type": "string", "enum": ["PASS", "FAIL"] },
        "gate": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/GateId" },
        "category": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/EvidenceCategory" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" }
        },
        "observations": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/GateObservation" } }
      }
    },
    "UndecidedGate": {
      "title": "UndecidedGate",
      "description": "INSUFFICIENT or NOT_APPLICABLE, with a reason code and the reason shown to readers. A policy-recorded reason repeats the cohort policy text. evidence and observations are present when runs were read, for example a trade count below a sample-size threshold.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "gate", "category", "reason_code", "reason"],
      "properties": {
        "result": { "type": "string", "enum": ["INSUFFICIENT", "NOT_APPLICABLE"] },
        "gate": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/GateId" },
        "category": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/EvidenceCategory" },
        "reason_code": { "$ref": "#/$defs/GateReasonCode" },
        "reason": { "type": "string", "maxLength": 1000 },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" }
        },
        "observations": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/GateObservation" } }
      }
    },
    "GateReasonCode": {
      "title": "GateReasonCode",
      "description": "POLICY_RECORDED: the cohort policy records the gate as INSUFFICIENT or NOT_APPLICABLE. BELOW_THRESHOLD: a threshold that the policy maps to INSUFFICIENT does not hold, for example too few closed trades. OUTSIDE_ENGINE_DOMAIN: a run failed with ARITHMETIC_OVERFLOW. The other codes name the missing evidence.",
      "type": "string",
      "enum": [
        "POLICY_RECORDED",
        "BELOW_THRESHOLD",
        "VALIDATION_FAILED",
        "RUN_FAILED",
        "RUN_INSUFFICIENT",
        "RUN_MISSING",
        "OUTSIDE_ENGINE_DOMAIN",
        "METRICS_UNAVAILABLE",
        "BENCHMARK_UNAVAILABLE"
      ]
    },
    "GateObservation": {
      "title": "GateObservation",
      "description": "One threshold check: the observed metric of one run against the policy threshold.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "metric", "window", "cost_scenario", "observed", "comparison", "threshold", "holds"],
      "properties": {
        "run_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "metric": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/MetricName" },
        "window": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/WindowRole" },
        "cost_scenario": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/CostScenario" },
        "observed": { "$ref": "urn:openquant:schema:common:1#/$defs/Decimal" },
        "comparison": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ThresholdComparison" },
        "threshold": { "$ref": "urn:openquant:schema:common:1#/$defs/Decimal" },
        "holds": { "type": "boolean" }
      }
    }
  }
}
