{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openquant:schema:command:1",
  "title": "Command",
  "description": "Guarded command and its read-back status (OQ-05 sections 3 and 8, OQ-04 section 12). People send the request form through the routes in v1.json with their own command_id; a repeat with the same body returns the same status. The API answers with the status form, and GET returns it again. record_evaluation_decision and freeze_candidates are internal: only the workflows service principal applies them, under an approved cohort policy, and no route accepts them. PENDING, APPLIED and REJECTED are server states. UNKNOWN is a client state: a timeout does not prove that no state changed.",
  "oneOf": [
    { "$ref": "#/$defs/CommandRequest" },
    { "$ref": "#/$defs/CommandPending" },
    { "$ref": "#/$defs/CommandApplied" },
    { "$ref": "#/$defs/CommandRejected" }
  ],
  "$defs": {
    "CommandKind": {
      "title": "CommandKind",
      "type": "string",
      "enum": [
        "register_research_profile",
        "register_cohort_policy",
        "register_budget",
        "register_seed",
        "create_mission",
        "run_mission_now",
        "cancel_mission",
        "record_evaluation_decision",
        "freeze_candidates"
      ]
    },
    "CommandRequest": {
      "title": "CommandRequest",
      "description": "expected_revision is the compare-and-set revision of the target record. 0 means the record must not exist yet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "form", "command_id", "expected_revision", "issued_at", "payload"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["command/1"] },
        "form": { "type": "string", "enum": ["request"] },
        "command_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "expected_revision": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "issued_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" },
        "payload": { "$ref": "#/$defs/CommandPayload" }
      }
    },
    "CommandPayload": {
      "title": "CommandPayload",
      "oneOf": [
        { "$ref": "#/$defs/RegisterResearchProfile" },
        { "$ref": "#/$defs/RegisterCohortPolicy" },
        { "$ref": "#/$defs/RegisterBudget" },
        { "$ref": "#/$defs/RegisterSeed" },
        { "$ref": "#/$defs/CreateMission" },
        { "$ref": "#/$defs/RunMissionNow" },
        { "$ref": "#/$defs/CancelMission" },
        { "$ref": "#/$defs/RecordEvaluationDecision" },
        { "$ref": "#/$defs/FreezeCandidates" }
      ]
    },
    "RegisterResearchProfile": {
      "title": "RegisterResearchProfile",
      "description": "Steward. Registers a new research profile revision for future work.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profile"],
      "properties": {
        "kind": { "type": "string", "enum": ["register_research_profile"] },
        "profile": { "$ref": "urn:openquant:schema:research-profile:1" }
      }
    },
    "RegisterCohortPolicy": {
      "title": "RegisterCohortPolicy",
      "description": "Steward. Registers and approves a new cohort policy revision before any trial uses it. Applying it records the Steward's approval Decision, which every policy-determined Decision under that revision names.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "policy"],
      "properties": {
        "kind": { "type": "string", "enum": ["register_cohort_policy"] },
        "policy": { "$ref": "urn:openquant:schema:cohort-policy:1" }
      }
    },
    "RegisterBudget": {
      "title": "RegisterBudget",
      "description": "Steward. Registers a spending cap for a declared calendar period, across missions. Missions draw on it; new missions do not reset it. Service principals cannot create or enlarge it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "budget"],
      "properties": {
        "kind": { "type": "string", "enum": ["register_budget"] },
        "budget": { "$ref": "#/$defs/BudgetCap" }
      }
    },
    "BudgetCap": {
      "title": "BudgetCap",
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_id", "revision", "period", "model_spend", "provider_requests"],
      "properties": {
        "budget_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "period": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/CalendarDateRange" },
        "model_spend": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/MoneyAmount" },
        "provider_requests": { "type": "integer", "minimum": 0, "maximum": 10000000 }
      }
    },
    "RegisterSeed": {
      "title": "RegisterSeed",
      "description": "Researcher. Registers a seed that the Researcher authored as version 1 of a new strategy, with its sources and every source-to-seed difference. It passes the same validation and critique as any candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "strategy", "origin", "sources", "source_differences"],
      "properties": {
        "kind": { "type": "string", "enum": ["register_seed"] },
        "strategy": { "$ref": "urn:openquant:schema:strategy-artefact:1" },
        "origin": { "type": "string", "enum": ["researcher_authored"] },
        "sources": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/SeedSource" } },
        "source_differences": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/SourceDifference" }
        }
      }
    },
    "SeedSource": {
      "title": "SeedSource",
      "description": "A source reference: untrusted reference text, identified by the SHA-256 of its exact bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "content_digest", "description"],
      "properties": {
        "source_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "content_digest": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "CreateMission": {
      "title": "CreateMission",
      "description": "Researcher. Creates a mission. The API assigns the mission ID and returns it in the status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mission"],
      "properties": {
        "kind": { "type": "string", "enum": ["create_mission"] },
        "mission": { "$ref": "#/$defs/MissionSpec" }
      }
    },
    "MissionSpec": {
      "title": "MissionSpec",
      "description": "One-instrument research mission. budget is the per-mission budget. The API rejects it when it exceeds the cohort policy maxima, breaks the equal-per-proposer rule or does not fit the remaining period cap that the profile names. Each proposer configuration authors one controlled revision of the seed. The critic uses a separate profile and session.",
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "instrument", "profile", "cohort_policy", "budget", "seed_hash", "proposers", "critic"],
      "properties": {
        "objective": { "type": "string", "maxLength": 2000 },
        "instrument": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/InstrumentMapping" },
        "profile": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/RecordRef" },
        "cohort_policy": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/RecordRef" },
        "budget": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/MissionBudget" },
        "seed_hash": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "proposers": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/AgentConfiguration" } },
        "critic": { "$ref": "#/$defs/AgentConfiguration" }
      }
    },
    "AgentConfiguration": {
      "title": "AgentConfiguration",
      "description": "A proposer or critic configuration: executor profile plus behaviour-bundle hash, with the configured model's knowledge cutoff as the provider states it (OQ-03 section 2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "executor_profile", "bundle_hash", "knowledge_cutoff"],
      "properties": {
        "configuration_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "executor_profile": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ExecutorProfile" },
        "bundle_hash": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "knowledge_cutoff": { "$ref": "#/$defs/KnowledgeCutoff" }
      }
    },
    "KnowledgeCutoff": {
      "title": "KnowledgeCutoff",
      "oneOf": [{ "$ref": "#/$defs/PublishedKnowledgeCutoff" }, { "$ref": "#/$defs/UnpublishedKnowledgeCutoff" }]
    },
    "PublishedKnowledgeCutoff": {
      "title": "PublishedKnowledgeCutoff",
      "description": "The cutoff as the model provider states it (year and month, or a full date), the documentation it was read from and the date it was read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cutoff", "source", "read_on"],
      "properties": {
        "status": { "type": "string", "enum": ["published"] },
        "cutoff": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(?:-[0-9]{2})?$" },
        "source": { "type": "string", "maxLength": 300 },
        "read_on": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/CalendarDate" }
      }
    },
    "UnpublishedKnowledgeCutoff": {
      "title": "UnpublishedKnowledgeCutoff",
      "description": "The provider documentation read states no cutoff for this model. It is never inferred. reason names what was read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "type": "string", "enum": ["unknown"] },
        "reason": { "type": "string", "maxLength": 500 }
      }
    },
    "RunMissionNow": {
      "title": "RunMissionNow",
      "description": "Researcher. Starts the mission's bounded work now. Policy-determined Decisions of the mission name the Researcher who applied it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mission_id"],
      "properties": {
        "kind": { "type": "string", "enum": ["run_mission_now"] },
        "mission_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" }
      }
    },
    "CancelMission": {
      "title": "CancelMission",
      "description": "Researcher. Withdraws the mission: it becomes WITHDRAWN, its open runs become CANCELLED and its open agent attempts are cancelled. Cancellation does not prove that a remote request stopped or cost nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mission_id", "reason"],
      "properties": {
        "kind": { "type": "string", "enum": ["cancel_mission"] },
        "mission_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "RecordEvaluationDecision": {
      "title": "RecordEvaluationDecision",
      "description": "Internal: the workflows service principal only. Records the policy-determined DRAFT to EVALUATING Decision for the candidate in one trial slot (OQ-02 section 4). outcome follows from critique and the policy: APPROVED when the critique gave a valid result and no finding blocks this transition, REJECTED when one does, DEFERRED when the critique ended without a valid result after the attempt cap. In S1 no finding category blocks this transition. Applying an APPROVED Decision writes the candidate's development and validation runs, their reservations and outbox entries in one transaction. A DEFERRED candidate is not evaluated.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mission_id", "plan_digest", "trial_slot", "strategy_hash", "critique", "outcome", "authority"],
      "properties": {
        "kind": { "type": "string", "enum": ["record_evaluation_decision"] },
        "mission_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "plan_digest": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "trial_slot": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "strategy_hash": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "critique": { "$ref": "#/$defs/CritiqueEvidence" },
        "outcome": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/DecisionOutcome" },
        "authority": { "$ref": "#/$defs/PolicyAuthority" }
      }
    },
    "CritiqueEvidence": {
      "title": "CritiqueEvidence",
      "oneOf": [{ "$ref": "#/$defs/CompletedCritique" }, { "$ref": "#/$defs/MissingCritique" }]
    },
    "CompletedCritique": {
      "title": "CompletedCritique",
      "description": "The critique attempt that completed. result is its strategy-critique.result/1 role output.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempt_id", "result"],
      "properties": {
        "status": { "type": "string", "enum": ["COMPLETED"] },
        "attempt_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "result": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" }
      }
    },
    "MissingCritique": {
      "title": "MissingCritique",
      "description": "The critique ended without a valid result after the attempt cap. outcome is the last attempt's outcome. attempts counts the attempts made.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome", "attempts"],
      "properties": {
        "status": { "type": "string", "enum": ["NO_VALID_RESULT"] },
        "outcome": {
          "type": "string",
          "enum": ["refusal", "malformed_result", "denied_capability", "authentication_failure", "cancellation", "timeout"]
        },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "PolicyAuthority": {
      "title": "PolicyAuthority",
      "description": "The authority behind a policy-determined Decision: the approved cohort policy revision, the Steward's approval Decision for it and the Researcher who started the mission.",
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_policy", "policy_approval", "mission_started_by"],
      "properties": {
        "cohort_policy": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/RecordRef" },
        "policy_approval": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "mission_started_by": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" }
      }
    },
    "FreezeCandidates": {
      "title": "FreezeCandidates",
      "description": "Internal: the workflows service principal only, under the approved policy. Freezes the candidate set once every trial slot is terminal (OQ-02 sections 3.3 and 4). slots lists every trial slot of the plan. Applying it writes the holdout runs of every EVALUATING slot, their reservations and outbox entries in one transaction. If no slot is EVALUATING, it writes no run and the mission concludes NO_ELIGIBLE_CANDIDATE with the recorded reasons.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mission_id", "plan_digest", "slots"],
      "properties": {
        "kind": { "type": "string", "enum": ["freeze_candidates"] },
        "mission_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "plan_digest": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "slots": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/FrozenSlot" } }
      }
    },
    "FrozenSlot": {
      "title": "FrozenSlot",
      "oneOf": [{ "$ref": "#/$defs/EvaluatedSlot" }, { "$ref": "#/$defs/UnevaluatedSlot" }]
    },
    "EvaluatedSlot": {
      "title": "EvaluatedSlot",
      "description": "A slot whose candidate is EVALUATING. strategy_hash is the Strategy Version that its APPROVED Decision bound.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_slot", "status", "strategy_hash"],
      "properties": {
        "trial_slot": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "status": { "type": "string", "enum": ["EVALUATING"] },
        "strategy_hash": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" }
      }
    },
    "UnevaluatedSlot": {
      "title": "UnevaluatedSlot",
      "description": "A slot that gets no runs. DECISION_DEFERRED: the critique gave no valid result. NO_REGISTERED_VERSION: no proposal passed validation within the revision budget. SEED_NOT_EVALUATED: the seed was not evaluated, so no revision could run, because revision context needs the seed's development results.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_slot", "status", "reason"],
      "properties": {
        "trial_slot": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "status": { "type": "string", "enum": ["NOT_EVALUATED"] },
        "reason": { "type": "string", "enum": ["DECISION_DEFERRED", "NO_REGISTERED_VERSION", "SEED_NOT_EVALUATED"] }
      }
    },
    "CommandPending": {
      "title": "CommandPending",
      "description": "Accepted and durable, not yet applied.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "form", "command_id", "kind", "state", "received_at"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["command/1"] },
        "form": { "type": "string", "enum": ["status"] },
        "command_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "kind": { "$ref": "#/$defs/CommandKind" },
        "state": { "type": "string", "enum": ["PENDING"] },
        "received_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" }
      }
    },
    "CommandApplied": {
      "title": "CommandApplied",
      "description": "Committed. record names the record and the revision the command produced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "form", "command_id", "kind", "state", "received_at", "applied_at", "record"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["command/1"] },
        "form": { "type": "string", "enum": ["status"] },
        "command_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "kind": { "$ref": "#/$defs/CommandKind" },
        "state": { "type": "string", "enum": ["APPLIED"] },
        "received_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" },
        "applied_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" },
        "record": { "$ref": "#/$defs/CommandRecord" }
      }
    },
    "CommandRecord": {
      "title": "CommandRecord",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "CommandRejected": {
      "title": "CommandRejected",
      "description": "Rejected. No state changed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "form", "command_id", "kind", "state", "received_at", "rejected_at", "error"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["command/1"] },
        "form": { "type": "string", "enum": ["status"] },
        "command_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "kind": { "$ref": "#/$defs/CommandKind" },
        "state": { "type": "string", "enum": ["REJECTED"] },
        "received_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" },
        "rejected_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" },
        "error": { "$ref": "#/$defs/CommandError" }
      }
    },
    "CommandError": {
      "title": "CommandError",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ApiErrorCode" },
        "message": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
