{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openquant:schema:job-dispatch:1",
  "title": "JobDispatch",
  "description": "Batch queue message for one job attempt (OQ-05 section 4). It holds references only, never datasets. The API writes it to the outbox in the transaction that creates the attempt and its reservation. The worker claims the attempt with the digest of this message before it fetches any input or does any work. A redelivered message cannot authorise a second official result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "job_id", "attempt", "mission_id", "dispatched_at", "inputs"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["job-dispatch/1"] },
    "environment": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/DeploymentEnvironment" },
    "job_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
    "attempt": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/AttemptBinding" },
    "mission_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
    "dispatched_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" },
    "inputs": { "$ref": "#/$defs/JobInputs" }
  },
  "$defs": {
    "JobInputs": {
      "title": "JobInputs",
      "description": "Inputs by job kind. For an evaluate job, job_id is the run ID.",
      "oneOf": [
        { "$ref": "#/$defs/RetrieveJobInputs" },
        { "$ref": "#/$defs/ValidateJobInputs" },
        { "$ref": "#/$defs/EvaluateJobInputs" },
        { "$ref": "#/$defs/AssessJobInputs" }
      ]
    },
    "RetrieveJobInputs": {
      "title": "RetrieveJobInputs",
      "description": "request is a retrieval-request/1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "type": "string", "enum": ["retrieve"] },
        "request": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" }
      }
    },
    "ValidateJobInputs": {
      "title": "ValidateJobInputs",
      "description": "strategy and parent are strategy-artefact/1 documents; parent is absent for a version without a parent. cohort_policy supplies the warm-up rule.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "strategy", "cohort_policy"],
      "properties": {
        "kind": { "type": "string", "enum": ["validate"] },
        "strategy": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" },
        "parent": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" },
        "cohort_policy": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" }
      }
    },
    "EvaluateJobInputs": {
      "title": "EvaluateJobInputs",
      "description": "request is an evaluation-request/1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "type": "string", "enum": ["evaluate"] },
        "request": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" }
      }
    },
    "AssessJobInputs": {
      "title": "AssessJobInputs",
      "description": "Everything one candidate's gates read: the cohort policy, the validation result, every registered run of the candidate and the dataset manifests behind them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "strategy_hash", "cohort_policy", "validation", "runs", "manifests"],
      "properties": {
        "kind": { "type": "string", "enum": ["assess"] },
        "strategy_hash": { "$ref": "urn:openquant:schema:common:1#/$defs/Digest" },
        "cohort_policy": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" },
        "validation": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" },
        "runs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/AssessedRun" } },
        "manifests": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" }
        }
      }
    },
    "AssessedRun": {
      "title": "AssessedRun",
      "description": "One registered run of the candidate. submission is the committed evaluation-submission/1, absent when the run ended without one. replay_of names the run this run repeats for the deterministic replay check.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "window_role", "cost_scenario"],
      "properties": {
        "run_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "status": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/RunStatus" },
        "window_role": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/WindowRole" },
        "cost_scenario": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/CostScenario" },
        "replay_of": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "submission": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ArtefactRef" }
      }
    }
  }
}
