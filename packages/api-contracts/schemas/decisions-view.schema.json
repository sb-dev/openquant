{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openquant:schema:decisions-view:1",
  "title": "DecisionsView",
  "description": "Recorded Decisions with actor, outcome and evidence references. A policy-determined Decision also names the cohort policy, the Steward approval Decision and the Researcher who started the mission. The response body of missions.decisions (routes/v1.json). A value that nothing reported is null, never zero; arrays are always present and may be empty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "decisions"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["decisions-view/1"] },
    "mission_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/ViewDecision" },
      "maxItems": 64
    }
  },
  "$defs": {
    "ViewDecision": {
      "title": "ViewDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "kind", "outcome", "actor_id", "actor_kind", "cohort_policy", "mission_id", "trial_slot", "strategy_hash", "plan_digest", "policy_approval_decision", "mission_started_by", "critique_status", "critique_digest", "reason", "decided_at"],
      "properties": {
        "decision_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "kind": { "type": "string", "pattern": "^[A-Z_]{1,40}$" },
        "outcome": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/DecisionOutcome" },
        "actor_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
        "actor_kind": { "type": "string", "enum": ["HUMAN", "SERVICE"] },
        "cohort_policy": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewRecordRef" },
        "mission_id": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewIdentifier" },
            { "type": "null" }
          ]
        },
        "trial_slot": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewIdentifier" },
            { "type": "null" }
          ]
        },
        "strategy_hash": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewDigest" },
            { "type": "null" }
          ]
        },
        "plan_digest": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewDigest" },
            { "type": "null" }
          ]
        },
        "policy_approval_decision": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewIdentifier" },
            { "type": "null" }
          ]
        },
        "mission_started_by": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewIdentifier" },
            { "type": "null" }
          ]
        },
        "critique_status": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewState" },
            { "type": "null" }
          ]
        },
        "critique_digest": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewDigest" },
            { "type": "null" }
          ]
        },
        "reason": {
          "oneOf": [
            { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ViewText" },
            { "type": "null" }
          ]
        },
        "decided_at": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" }
      }
    }
  }
}
