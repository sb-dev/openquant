{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openquant:schema:retrieval-request:1",
  "title": "RetrievalRequest",
  "description": "A guarded market-data retrieval for one retrieve job attempt (OQ-05 section 7.1). It binds the profile revision, stable instrument mapping, operations, range, information cutoff, semantics, limits and deadline. Provider defaults never choose financial semantics. The API creates it; the batch host fetches it by digest after it claims the attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "attempt", "environment", "profile", "instrument", "operations", "range", "information_cutoff", "semantics", "limits", "deadline"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["retrieval-request/1"] },
    "job_id": { "$ref": "urn:openquant:schema:common:1#/$defs/Identifier" },
    "attempt": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/AttemptBinding" },
    "environment": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/DeploymentEnvironment" },
    "profile": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/RecordRef" },
    "instrument": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/InstrumentMapping" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/ProviderCapabilityRef" }
    },
    "range": { "$ref": "urn:openquant:schema:connected-common:1#/$defs/DateRange" },
    "information_cutoff": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" },
    "semantics": { "$ref": "urn:openquant:schema:research-profile:1#/$defs/DataSemantics" },
    "limits": { "$ref": "#/$defs/RetrievalLimits" },
    "deadline": { "$ref": "urn:openquant:schema:common:1#/$defs/UtcTimestamp" }
  },
  "$defs": {
    "RetrievalLimits": {
      "title": "RetrievalLimits",
      "description": "Bounds enforced outside the adapter. max_requests counts every provider request, retries and pages included. Only classified transient failures are retried, within max_retries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_requests", "max_retries", "request_timeout_seconds", "max_response_bytes"],
      "properties": {
        "max_requests": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "request_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    }
  }
}
