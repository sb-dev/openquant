  "contract": {
    "hypothesis": "A liquid stock above its 50-session mean that recently dipped to a weak RSI and now shows rising volume tends to recover over days to weeks.",
    "rationale": "Corrected daily swing seed family from OQ-02 section 2.6: simple-mean RSI and ATR, lagged weakness without a required crossing, current volume mean, next-open fills, ATR protection.",
    "intended_conditions": [
      "Daily bars, one market and currency, long-only cash positions, five slots."
    ],
    "benchmarks": [
      "Declared by the evaluation policy, not by the strategy."
    ],
    "assumptions": [
      "Fills at the next session open under the declared cost model.",
      "Signal prices are split-adjusted from actions available at the signal session."
    ],
    "invalidation": [
      "Entry signals fail to precede positive forward returns across the cohort."
    ]
  },
